        &self,
        x: &mut Vec<DVec3>,
        predicted: &[DVec3],
        frame: Frame,
        dt: f64,
        contacts: &[PlaneContact],
        damping: &Dissipation,
    ) -> Result<(), TissueError> {
        for _ in 0..self.material.iterations {
            let system = self.linearize(x, predicted, frame, dt, contacts, damping);
            if dot(&system.gradient, &system.gradient) < 1e-16 {
                break;
            }
            let delta = system.direction();
            let slope = dot(&system.gradient, &delta);
            // Both force balance and the remaining Newton correction must be
            // small. A force-only check is insufficient for compliant modes.
            // Engineering limits: 0.1 mN global free-force norm and 0.1 um per
            // node. The configured iteration count remains the upper bound.
            if dot(&system.gradient, &system.gradient) <= 1e-8
                && delta.iter().all(|d| d.length_squared() <= 1e-14)
            {
                break;
            }
            *x = self.descend(x, &delta, slope, |x| {
                self.objective(x, predicted, frame, dt)
                    + contacts
                        .iter()
                        .map(|c| c.energy(x, &self.tets))
                        .sum::<f64>()
                    + damping.energy(x, &self.tets)
            })?;
        }
        Ok(())
    }]]><calls total="10"><c n="energy" l="73">pub(super) fn energy(&amp;self, positions: &amp;[DVec3], tets: &amp;[Tet]) -&gt; f64</c><c n="dot" l="16">fn dot(a: &amp;[DVec3], b: &amp;[DVec3]) -&gt; f64</c><c n="direction" l="42">fn direction(&amp;self) -&gt; Vec&lt;DVec3&gt;</c><c n="descend" l="121">fn descend( &amp;self, x: &amp;[DVec3], delta: &amp;[DVec3], slope: f64, objective: impl Fn(&amp;[DVec3]) -&gt; f64, ) -&gt; Result&lt;Vec&lt;DVec3&gt;, TissueError&gt;</c><c n="linearize" l="142">fn linearize( &amp;self, x: &amp;[DVec3], predicted: &amp;[DVec3], frame: Frame, dt: f64, contacts: &amp;[PlaneContact], damping: &amp;Dissipation, ) -&gt; System</c><c n="objective" l="282">fn objective(&amp;self, x: &amp;[DVec3], predicted: &amp;[DVec3], frame: Frame, dt: f64) -&gt; f64</c><c n="energy" l="94">pub fn energy(&amp;self, positions: &amp;[DVec3], mu: f64, lambda: f64, stiffening: f64) -&gt; f64</c><c n="energy" l="28">pub fn energy(&amp;self, x: &amp;[DVec3]) -&gt; f64</c><c n="energy" l="48">pub fn energy(&amp;self, x: &amp;[DVec3], tets: &amp;[Tet]) -&gt; f64</c><c n="energy" l="46">pub fn energy(&amp;self, tet: &amp;Tet, x: &amp;[DVec3]) -&gt; f64</c></calls></b><b t="var" l="22" p="artifacts/soft-tissue/sparse-solver/profile.py" n="s"><![CDATA[s=s.replace('    Ok(())\n}', '    soft_tissue::solver::implicit::profile();\n    Ok(())\n}')]]></b><b t="var" l="5" p="artifacts/soft-tissue/sparse-solver/profile.py" n="s"><![CDATA[s=p.read_text()]]></b></bodies></ctx>