from os import PathLike
from typing import TypedDict

class Slider(TypedDict):
    id: str
    name: str
    category: str
    min: float
    max: float
    base: float

class Pack:
    """A CC5 slider pack (`pack.json` + `pack.bin`)."""
    def __init__(self, dir: str | PathLike[str]) -> None: ...
    @property
    def vertex_count(self) -> int: ...
    @property
    def joints(self) -> list[str]: ...
    @property
    def meshes(self) -> list[tuple[str, int, int]]: ...
    @property
    def sliders(self) -> list[Slider]: ...
    def categories(self) -> list[tuple[str, list[int]]]: ...
    def find(self, key: str) -> int: ...
    def base_weights(self) -> list[float]: ...
    def weights(self, set: dict[str, float] | None = None) -> list[float]: ...
    def evaluate(self, weights: list[float]) -> tuple[bytes, dict[str, tuple[float, float, float]]]: ...
    def recipe(self, weights: list[float]) -> str: ...
    def weights_from_recipe(self, recipe: str) -> list[float]: ...
    def state(self, i: int, which: str) -> tuple[float, bytes, bytes, bytes, bytes] | None: ...
    def shape_glb(self, glb: bytes, weights: list[float], hd: SubdivMap | None = None) -> bytes:
        """Shaped copy of a GLB carrying `_CCIDX`; with `hd`, of the CC5 HD export."""

class Expressions:
    """A CC5 expression pack (`expressions.json` + `expressions.bin`): facial morphs
    as sparse vertex deltas in the slider pack's global vertex space (glTF frame, m)."""
    def __init__(self, dir: str | PathLike[str]) -> None: ...
    @property
    def vertex_count(self) -> int: ...
    @property
    def meshes(self) -> list[tuple[str, int, int]]: ...
    @property
    def names(self) -> list[str]: ...
    def find(self, name: str) -> int: ...
    def meshes_of(self, name: str) -> list[str]: ...
    def deltas(self, name: str) -> tuple[bytes, bytes]: ...
    def evaluate(self, weights: dict[str, float]) -> bytes: ...
    def __len__(self) -> int: ...

class ArkitMap:
    """ARKit-52 blendshape weights -> expression weights (runtime ARKit map JSON)."""
    def __init__(self, path: str | PathLike[str], expressions: Expressions) -> None: ...
    @property
    def arkit_names(self) -> list[str]: ...
    @property
    def missing(self) -> list[str]: ...
    def weights(self, arkit: dict[str, float]) -> dict[str, float]: ...

class SubdivMap:
    """Slider pack (CC5 subdivision 0) -> CC5 HD mesh map (`hd_map.json` + `hd_map.bin`)."""
    def __init__(self, dir: str | PathLike[str]) -> None: ...
    @property
    def level(self) -> int: ...
    @property
    def vertex_count(self) -> int: ...
    @property
    def meshes(self) -> list[tuple[str, int, int]]:
        """`[(mesh name, HD offset, HD count)]`."""
    def expand(self, verts: bytes) -> bytes:
        """Base-space f32 xyz per vertex -> HD-space f32 xyz per vertex."""

class Conform:
    """Bind an uncaptured mesh (hair cards, a beard) to body anchor vertices so it
    follows the body's shape. `body` / `asset`: f32 xyz bytes of bind positions in
    one space; `anchors`: indices into `body` (the head for scalp hair, face for beards);
    `mode`: "scalp" (wide falloff + whole-head similarity), "skin" or "head_box"
    (map the anchors' bounding box: hair layers CC5 moves rigidly)."""

    def __init__(self, body: bytes, anchors: list[int], asset: bytes, mode: str = "scalp", k: int | None = None,
                 sigma_min: float | None = None, sigma_scale: float | None = None,
                 similarity: bool | None = None) -> None: ...
    def apply(self, body_delta: bytes) -> bytes:
        """Body vertex deltas (f32 xyz bytes) -> asset vertex deltas (f32 xyz bytes)."""
    def __len__(self) -> int: ...
